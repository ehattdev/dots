// ### DEFAULT Laptop  - Top ### //
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/modules/init.jsonc"
  ],

"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 5,
"margin-bottom": 0,
"margin-left": 10,
"margin-right": 10,

"modules-left": [
        "group/app_drawer",
        "custom/separator#blank_2",
        "cava",
        "custom/separator#blank",
        "custom/playerctl",
        "custom/separator#blank_2",
        "hyprland/window",
],

"modules-center": [
	"custom/separator#blank",
	"custom/swaync",
	"custom/separator#blank",
	"hyprland/workspaces#rw",
	"clock",
	],

"modules-right": [
	"tray",
        "custom/weather",
	// "network#speed",
	"custom/separator#blank",
	"group/laptop",
	"custom/separator#blank",
	"group/mobo_drawer",
	"custom/separator#blank",  
	"group/audio",
	"custom/separator#blank", 
	"group/status",
	],
}

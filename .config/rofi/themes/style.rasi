@import "mocha.rasi"
* {
    font:   "Maple Mono NF 20";

    background-color:   transparent;
    text-color:         @text;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "  apps";
    display-run:                "  run";
    display-filebrowser:        "  files";
    display-window:             "  window";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    terminal:                   "ghostty";
}

window {
    location:       center;
    y-offset:       calc(50% - 176px);
    width:          25%;
    border-radius:  24px;

    background-color:   @base;
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   @surface0;
    border-color:       @mauve;

    border:         2px;
    border-radius:  16px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @flamingo;
}

entry {
    placeholder:        "   | c-tab to switch mode ";
    placeholder-color:  @overlay2;
}

message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       @surface1;
    background-color:   @surface1;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     12px 0 0;
    lines:      10;
    columns:    1;

    fixed-height: false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: @mauve;
}

element alternate active {
    text-color: @mauve;
}

element selected normal, element selected active {
    background-color:   @mauve;
    text-color: @surface0;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}

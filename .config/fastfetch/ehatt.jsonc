{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
  "source": "/home/ehatt/.config/fastfetch/brat.png",
  "width": 17,
  "padding": {
  	"top": 1,
    "left": 2
  }
  },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "keyWidth": 10,
			"format": "󰴈  {user-name} {host-name} 󰴈 ", 
            "outputColor": "#f5c2e7"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "#74c7ec",
            "format": "{release}",
            "outputColor": "#f5e0dc"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#fab387",
            "format": "{pretty-name} {version}",
            "outputColor": "#f5e0dc"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#a6e3a1",
            "outputColor": "#f5e0dc"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#eba0ac",
            "format": "{pretty-name}",
            "outputColor": "#f5e0dc"
        },
        {
            "type": "packages",
            "key": "󰮯 ",
            "keyColor": "#f9e2af",
            "format": "{2}",
            "outputColor": "#f5e0dc"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "#94e2d5",
            "format": "{hours}h {minutes}m {seconds}s",
            "outputColor": "#f5e0dc"
        },
        {
            "type": "custom",
            "format": "\u001b[31m   \u001b[32m   \u001b[33m   \u001b[34m   \u001b[35m   \u001b[36m "
        },
		"break",
    ]
}
